// Schema do Prisma para o Finance AI
// Este arquivo define os modelos de dados para o sistema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Tenant (Multi-inquilino)
model Tenant {
  id          String    @id @default(uuid())
  nome        String
  dominio     String?   @unique
  ativo       Boolean   @default(true)
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  dataAtualizacao DateTime? @updatedAt @map("data_atualizacao")

  // Relações
  empresas    Empresa[]
  usuarios    Usuario[]
  gruposPermissoes GrupoPermissao[]

  @@map("tenants")
}

// Modelo de Empresa
model Empresa {
  id          String    @id @default(uuid())
  nome        String
  cnpj        String?   @unique
  ativa       Boolean   @default(true)
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  dataAtualizacao DateTime? @updatedAt @map("data_atualizacao")
  
  // Relações
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarios    UsuarioEmpresa[]
  permissoes  Permissao[]
  gruposPermissoes GrupoPermissao[]

  @@map("empresas")
  @@index([tenantId])
}

// Modelo de Usuário
model Usuario {
  id          String    @id @default(uuid())
  nome        String
  email       String    @unique
  senha       String
  ativo       Boolean   @default(true)
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  dataAtualizacao DateTime? @updatedAt @map("data_atualizacao")
  ultimoLogin DateTime? @map("ultimo_login")
  
  // Relações
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empresas    UsuarioEmpresa[]
  permissoes  Permissao[]
  refreshTokens RefreshToken[]
  perfis      PerfilUsuario[]
  gruposPermissoes UsuarioGrupoPermissao[]

  @@map("usuarios")
  @@index([tenantId])
}

// Relacionamento Usuário-Empresa
model UsuarioEmpresa {
  id          String    @id @default(uuid())
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  
  // Relações
  usuarioId   String    @map("usuario_id")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId   String    @map("empresa_id")
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@map("usuarios_empresas")
  @@index([usuarioId])
  @@index([empresaId])
}

// Modelo de Módulo
model Modulo {
  id          String    @id @default(uuid())
  nome        String
  codigo      String    @unique
  descricao   String?
  ativo       Boolean   @default(true)
  
  // Relações
  submodulos  Submodulo[]
  permissoes  Permissao[]

  @@map("modulos")
}

// Modelo de Submódulo
model Submodulo {
  id          String    @id @default(uuid())
  nome        String
  codigo      String
  descricao   String?
  ativo       Boolean   @default(true)
  
  // Relações
  moduloId    String    @map("modulo_id")
  modulo      Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  recursos    Recurso[]
  permissoes  Permissao[]

  @@unique([moduloId, codigo])
  @@map("submodulos")
  @@index([moduloId])
}

// Modelo de Recurso
model Recurso {
  id          String    @id @default(uuid())
  nome        String
  codigo      String
  descricao   String?
  ativo       Boolean   @default(true)
  
  // Relações
  submoduloId String    @map("submodulo_id")
  submodulo   Submodulo @relation(fields: [submoduloId], references: [id], onDelete: Cascade)
  permissoes  Permissao[]

  @@unique([submoduloId, codigo])
  @@map("recursos")
  @@index([submoduloId])
}

// Modelo de Ação
model Acao {
  id          String    @id @default(uuid())
  nome        String
  codigo      String    @unique
  descricao   String?
  
  // Relações
  permissoes  Permissao[]

  @@map("acoes")
}

// Modelo de Permissão
model Permissao {
  id          String    @id @default(uuid())
  permitido   Boolean   @default(true)
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  
  // Relações
  usuarioId   String?   @map("usuario_id")
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId   String    @map("empresa_id")
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  moduloId    String    @map("modulo_id")
  modulo      Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  submoduloId String?   @map("submodulo_id")
  submodulo   Submodulo? @relation(fields: [submoduloId], references: [id], onDelete: Cascade)
  recursoId   String?   @map("recurso_id")
  recurso     Recurso?  @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  acaoId      String    @map("acao_id")
  acao        Acao      @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  perfis      PerfilPermissao[]
  gruposPermissoes PermissaoGrupo[]

  @@unique([usuarioId, empresaId, moduloId, submoduloId, recursoId, acaoId])
  @@map("permissoes")
  @@index([usuarioId])
  @@index([empresaId])
  @@index([moduloId])
  @@index([submoduloId])
  @@index([recursoId])
  @@index([acaoId])
}

// Modelo de RefreshToken
model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  revogado    Boolean   @default(false)
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  dataAtualizacao DateTime? @updatedAt @map("data_atualizacao")
  
  // Relações
  usuarioId   String    @map("usuario_id")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([usuarioId])
  @@index([token])
}

// Modelo de Perfil
model Perfil {
  id          String    @id @default(uuid())
  nome        String
  descricao   String?
  ativo       Boolean   @default(true)
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  dataAtualizacao DateTime? @updatedAt @map("data_atualizacao")
  
  // Relações
  tenantId    String    @map("tenant_id")
  empresaId   String?   @map("empresa_id")
  usuarios    PerfilUsuario[]
  permissoes  PerfilPermissao[]

  @@unique([tenantId, nome, empresaId])
  @@map("perfis")
  @@index([tenantId])
  @@index([empresaId])
}

// Relacionamento Perfil-Usuário
model PerfilUsuario {
  id          String    @id @default(uuid())
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  
  // Relações
  perfilId    String    @map("perfil_id")
  perfil      Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  usuarioId   String    @map("usuario_id")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([perfilId, usuarioId])
  @@map("perfis_usuarios")
  @@index([perfilId])
  @@index([usuarioId])
}

// Relacionamento Perfil-Permissão
model PerfilPermissao {
  id          String    @id @default(uuid())
  dataCriacao DateTime  @default(now()) @map("data_criacao")
  
  // Relações
  perfilId    String    @map("perfil_id")
  perfil      Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissaoId String    @map("permissao_id")
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([perfilId, permissaoId])
  @@map("perfis_permissoes")
  @@index([perfilId])
  @@index([permissaoId])
}

// Modelo para grupos de permissões
model GrupoPermissao {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  empresaId   String   @map("empresa_id")
  tenantId    String   @map("tenant_id")
  dataCriacao DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime? @updatedAt @map("data_atualizacao")

  // Relacionamentos
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  // Relacionamentos muitos-para-muitos
  permissoesGrupo      PermissaoGrupo[]
  usuariosGrupo        UsuarioGrupoPermissao[]

  @@map("grupos_permissoes")
  @@index([empresaId])
  @@index([tenantId])
}

// Tabela de relacionamento entre grupos e permissões
model PermissaoGrupo {
  id              String        @id @default(uuid())
  grupoPermissaoId String       @map("grupo_permissao_id")
  permissaoId     String       @map("permissao_id")
  
  // Relacionamentos
  grupoPermissao  GrupoPermissao @relation(fields: [grupoPermissaoId], references: [id], onDelete: Cascade)
  permissao       Permissao      @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([grupoPermissaoId, permissaoId])
  @@map("permissoes_grupos")
  @@index([grupoPermissaoId])
  @@index([permissaoId])
}

// Tabela de relacionamento entre usuários e grupos
model UsuarioGrupoPermissao {
  id              String        @id @default(uuid())
  usuarioId       String        @map("usuario_id")
  grupoPermissaoId String       @map("grupo_permissao_id")
  
  // Relacionamentos
  usuario         Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grupoPermissao  GrupoPermissao @relation(fields: [grupoPermissaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, grupoPermissaoId])
  @@map("usuarios_grupos_permissoes")
  @@index([usuarioId])
  @@index([grupoPermissaoId])
}
