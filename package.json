{
  "name": "finance-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "api",
    "app/*",
    "landing",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run kill-ports && turbo run dev",
    "kill-ports": "npx kill-port 3000 3001 3002 3003 3004 3005",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "tsup": "^7.2.0",
    "turbo": "^1.10.12",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  }
}
