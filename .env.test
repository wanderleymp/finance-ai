# Configurações do Banco de Dados para Testes
DATABASE_URL="postgresql://saasadmin:saaspassword@localhost:5432/saas?schema=public"

# Configurações de Autenticação
JWT_SECRET="chave_secreta_jwt_para_testes"
JWT_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="7d"

# Configurações do Servidor
PORT=3001
NODE_ENV=test

# Configurações de Tenant
DEFAULT_TENANT_ID="tenant_teste"

# Configurações do AWS S3 (usando valores de teste)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test_access_key"
AWS_SECRET_ACCESS_KEY="test_secret_key"
AWS_S3_BUCKET="test_bucket"
