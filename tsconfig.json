{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "./tsbuildinfo.json"
  },
  "include": ["api/**/*.ts", "app/**/*.ts", "packages/**/*.ts", "jest.config.js"]
}
